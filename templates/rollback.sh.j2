#!/usr/bin/env bash
# =============================================================================
# DotSync Rollback Script
# =============================================================================
# Generated: {{ generated_at }}
# Reverts migration from {{ source_platform }} to {{ target_platform }}
# =============================================================================
#
# WARNING: This will restore your previous configuration.
# Any changes made after the migration will be lost.
#
# =============================================================================

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

BACKUP_DIR="$HOME/.dotsync_backup_{{ timestamp }}"

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

restore_backup() {
    if [ ! -d "$BACKUP_DIR" ]; then
        log_error "Backup directory not found: $BACKUP_DIR"
        log_error "Cannot rollback without a backup."
        exit 1
    fi

    log_info "Restoring from backup: $BACKUP_DIR"

{% for file in backup_files %}
    if [ -f "$BACKUP_DIR/{{ file | basename }}" ]; then
        cp -r "$BACKUP_DIR/{{ file | basename }}" "{{ file }}"
        log_info "Restored: {{ file }}"
    elif [ -d "$BACKUP_DIR/{{ file | basename }}" ]; then
        cp -r "$BACKUP_DIR/{{ file | basename }}" "{{ file }}"
        log_info "Restored directory: {{ file }}"
    else
        log_warn "Backup not found for: {{ file }}"
    fi
{% endfor %}

    log_info "Rollback complete"
}

main() {
    echo ""
    echo -e "${YELLOW}============================================${NC}"
    echo -e "${YELLOW}  DotSync Rollback${NC}"
    echo -e "${YELLOW}============================================${NC}"
    echo ""

    if [ "${DRY_RUN:-false}" = true ]; then
        log_info "DRY RUN - Would restore from: $BACKUP_DIR"
{% for file in backup_files %}
        echo "  - {{ file }}"
{% endfor %}
    else
        if [ -z "${FORCE:-}" ]; then
            read -p "Are you sure you want to rollback? This will overwrite current configs. (y/N) " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                log_info "Rollback cancelled."
                exit 0
            fi
        fi

        restore_backup
    fi
}

main "$@"
